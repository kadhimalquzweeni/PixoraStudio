<Window x:Class="PixoraStudio.App.Windows.VideoOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

    <Grid Background="Transparent">

        <!-- Centre Play/Pause Button -->
        <Button x:Name="PlayPauseButton"
                Width="76"
                Height="76"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding PlayPauseCommand}"
                Content="▶"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White"
                Background="#CC252526"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                Visibility="Collapsed">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="50">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.9"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}"
                                     Value="True">
                            <Setter Property="Content" Value="Ⅱ"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsPlaying}"
                                     Value="False">
                            <Setter Property="Content" Value="▶"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Fullscreen Button -->
        <Button x:Name="FullscreenButton"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Content="⛶"
                FontSize="25"
                Foreground="White"
                Background="#CC252526"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Enter Fullscreen"
                Click="FullscreenButton_Click"
                Visibility="Collapsed"/>

        <!-- Fullscreen Playback Control Bar -->
        <Border x:Name="FullscreenControls"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#E617191E"
                Padding="24,16"
                Visibility="Collapsed">

            <StackPanel>

                <!-- Playback Position -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTime}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="PlaybackSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding TotalMilliseconds}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="PlaybackSlider_ValueChanged"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding VideoDuration}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Volume -->
                <Grid Margin="0,8,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Volume"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1"
                               Text="🔊"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider x:Name="VolumeSlider"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ValueChanged="FullscreenVolumeSlider_ValueChanged"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding Volume, StringFormat={}{0:0}%}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                <!-- Trim Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="✂  Start Trim Here"
                            Click="StartTrimHere_Click"
                            Padding="16,9"
                            Margin="0,0,10,0"
                            Background="#303640"
                            Foreground="White"
                            BorderBrush="#555B66"
                            Cursor="Hand"/>

                    <Button Content="✂  End Trim Here"
                            Click="EndTrimHere_Click"
                            Padding="16,9"
                            Background="#303640"
                            Foreground="White"
                            BorderBrush="#555B66"
                            Cursor="Hand"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

</Window>