<Window x:Class="PixoraStudio.App.Windows.VideoOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False">

    <Grid Background="Transparent">

        <!-- Centre Play/Pause Button -->
        <Button x:Name="PlayPauseButton"
                Width="76"
                Height="76"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding PlayPauseCommand}"
                Visibility="Collapsed">

            <Button.Style>
                <Style TargetType="{x:Type Button}"
                       BasedOn="{StaticResource OverlayCircleButtonStyle}">
                    <Setter Property="Opacity" Value="0.9"/>
                    <Setter Property="Content">
                        <Setter.Value>
                            <Path Data="{StaticResource PlayIconGeometry}"
                                  Width="28"
                                  Height="28"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <Path Data="{StaticResource PauseIconGeometry}"
                                          Width="25"
                                          Height="25"
                                          Stretch="Uniform"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Fullscreen Button -->
        <Button x:Name="FullscreenButton"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                ToolTip="Enter Fullscreen"
                Click="FullscreenButton_Click"
                Style="{StaticResource OverlayCornerButtonStyle}"
                Visibility="Collapsed">
            <Button.Content>
                <Path Data="{StaticResource MaximizeIconGeometry}"
                      Width="20"
                      Height="20"
                      Stretch="Uniform"
                      Stroke="White"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"/>
            </Button.Content>
        </Button>

        <!-- Fullscreen Playback Control Bar -->
        <Border x:Name="FullscreenControls"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#E617191E"
                Padding="24,16"
                Visibility="Collapsed">

            <StackPanel>

                <!-- Playback Position -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTime}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="PlaybackSlider"
                            PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding TotalMilliseconds}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding VideoDuration}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Volume -->
                <Grid Margin="0,8,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Volume"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Viewbox Grid.Column="1"
                             Width="20"
                             Height="20"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Path Style="{StaticResource VolumeLevelIconStyle}"
                              Width="24"
                              Height="24"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>
                    </Viewbox>

                    <Slider x:Name="VolumeSlider"
                            PreviewMouseLeftButtonUp="FullscreenVolumeSlider_PreviewMouseLeftButtonUp"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ValueChanged="FullscreenVolumeSlider_ValueChanged"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding Volume, StringFormat={}{0:0}%}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                <!-- Trim Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="✂  Start Trim Here"
                            Click="StartTrimHere_Click"
                            Padding="16,9"
                            Margin="0,0,10,0"
                            Background="#303640"
                            Foreground="White"
                            BorderBrush="#555B66"
                            Cursor="Hand"/>

                    <Button Content="✂  End Trim Here"
                            Click="EndTrimHere_Click"
                            Padding="16,9"
                            Background="#303640"
                            Foreground="White"
                            BorderBrush="#555B66"
                            Cursor="Hand"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

</Window>