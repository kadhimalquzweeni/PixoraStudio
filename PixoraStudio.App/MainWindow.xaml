<Window x:Class="PixoraStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PixoraStudio.App.Views"
    xmlns:vm="clr-namespace:PixoraStudio.App.ViewModels"
    Title="Pixora Studio"
    Width="1200"
    Height="750"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="#17191E">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PhotoEditorViewModel}">
            <views:PhotoEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VideoEditorViewModel}">
            <views:VideoEditorView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#1E2026"
                BorderBrush="#30323A"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="15">

                <TextBlock Text="PIXORA"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="10,15,10,35"
                           DockPanel.Dock="Top"/>

                <StackPanel DockPanel.Dock="Top">

                    <Button Content="⌂   Home"
                            Command="{Binding NavigateHomeCommand}"
                            Background="#30333C"
                            Foreground="White"
                            Padding="15"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"/>

                    <Button Content="▧   Photo Editor"
                            Command="{Binding OpenPhotoEditorCommand}"
                            Background="Transparent"
                            Foreground="#B8BBC5"
                            Padding="15"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"/>

                    <Button Content="▣   Video Editor"
                            Command="{Binding OpenVideoEditorCommand}"
                            Background="Transparent"
                            Foreground="#B8BBC5"
                            Padding="15"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"/>

                </StackPanel>

            </DockPanel>
        </Border>


        <!-- Main content -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0"
            Background="#1E2026"
            BorderBrush="#30323A"
            BorderThickness="0,0,0,1"
            Padding="20,10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Page Title -->
                    <TextBlock Grid.Column="0"
                       Text="{Binding CurrentPage}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                    <!-- Open File Button -->
                    <Button Grid.Column="1"
                    Content="＋  Open File"
                    Command="{Binding OpenFileCommand}"
                    Background="#3478D4"
                    Foreground="White"
                    Padding="16,8"
                    MinWidth="120"
                    Height="36"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Cursor="Hand"/>

                </Grid>

            </Border>

            <!-- Main View -->
            <ContentControl Grid.Row="1"
                   Content="{Binding CurrentViewModel}"/>

        </Grid>


    </Grid>
</Window>
