<UserControl x:Class="PixoraStudio.App.Views.MediaDownloaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#17191E">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,34" MaxWidth="1100" HorizontalAlignment="Left">
                <TextBlock Text="Download online media"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Queue direct video downloads and let PixoraStudio process them one at a time."
                           FontSize="14"
                           Foreground="#A0A3AD"
                           Margin="0,8,0,28"/>

                <Border Background="#22252D" BorderBrush="#30343D" BorderThickness="1"
                        CornerRadius="10" Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="VIDEO URL" Foreground="#AEB8C8"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                     Height="42" FontSize="13" Padding="12,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Paste a video URL"/>
                            <Button Grid.Column="1" Content="Check link"
                                    Command="{Binding CheckLinkCommand}"
                                    Background="#3478D4" Foreground="White"
                                    Margin="10,0,0,0" Padding="18,8" MinHeight="42"/>
                            <Button Grid.Column="2" Content="Clear"
                                    Command="{Binding ClearLinkCommand}"
                                    Margin="8,0,0,0" Padding="14,8" MinHeight="42"/>
                        </Grid>
                        <Border Background="#1B1E24" CornerRadius="6" Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DetectedPlatform}"
                                           Foreground="#8BC5FF" FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="#A0A3AD" TextWrapping="Wrap"
                                           Margin="0,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Add to download queue"
                                Command="{Binding AddToQueueCommand}"
                                Background="#3478D4" Foreground="White"
                                HorizontalAlignment="Left"
                                Padding="18,9" MinHeight="38" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#22252D" BorderBrush="#30343D"
                            BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD OPTIONS" Foreground="#AEB8C8"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,18"/>
                            <TextBlock Text="Format" Foreground="#D4D6DE" Margin="0,0,0,7"/>
                            <ComboBox ItemsSource="{Binding FormatOptions}"
                                      SelectedItem="{Binding SelectedFormat}"
                                      IsEnabled="False" Margin="0,0,0,16"/>
                            <TextBlock Text="Video quality" Foreground="#D4D6DE" Margin="0,0,0,7"/>
                            <ComboBox ItemsSource="{Binding QualityOptions}"
                                      SelectedItem="{Binding SelectedQuality}"
                                      IsEnabled="False" Margin="0,0,0,16"/>
                            <TextBlock Text="Save to" Foreground="#D4D6DE" Margin="0,0,0,7"/>
                            <TextBox Text="{Binding OutputFolder}" IsReadOnly="True"
                                     MinHeight="34"/>
                            <TextBlock Text="Format and quality selection will be enabled when stream extraction is implemented."
                                       Foreground="#858B98" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#22252D" BorderBrush="#30343D"
                            BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD QUEUE" Foreground="#AEB8C8"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding QueueCountText}" Foreground="#858B98"
                                               FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear completed"
                                        Command="{Binding ClearCompletedCommand}"
                                        Padding="10,6" VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding QueueItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B1E24" BorderBrush="#30343D"
                                                BorderThickness="1" CornerRadius="7"
                                                Padding="12" Margin="0,0,0,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="#D4D6DE"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="#8BC5FF" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                               Foreground="#AEB8C8" FontSize="11"/>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding Progress}"
                                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                             Height="5" Margin="0,7,0,0"/>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="#F19A9A" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding OutputPath}"
                                                           Foreground="#8BC5FF" FontSize="10"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="Cancel"
                                                            IsEnabled="{Binding CanCancel}"
                                                            Command="{Binding DataContext.CancelQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,5" Margin="0,0,6,0"/>
                                                    <Button Content="Retry"
                                                            IsEnabled="{Binding CanRetry}"
                                                            Command="{Binding DataContext.RetryQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,5" Margin="0,0,6,0"/>
                                                    <Button Content="Remove"
                                                            IsEnabled="{Binding CanRemove}"
                                                            Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,5"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Downloads are processed sequentially. Failed or cancelled items can be retried."
                                       Foreground="#858B98" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#1E2935" BorderBrush="#30465B" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="CURRENT SUPPORT" Foreground="#8BC5FF"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Direct MP4  ·  WebM  ·  MOV  ·  MKV links"
                                   Foreground="#D4D6DE" TextWrapping="Wrap"
                                   Margin="0,7,0,0" FontSize="13"/>
                        <TextBlock Text="Downloads will be limited to media you have permission to save. DRM, paywalls and access restrictions will not be bypassed."
                                   Foreground="#8D96A5" TextWrapping="Wrap"
                                   Margin="0,8,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
