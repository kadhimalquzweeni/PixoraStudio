<Window x:Class="PixoraStudio.App.Views.ColorPickerDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a colour" Width="310" Height="370"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202228" Foreground="#D4D6DE">
    <Border Background="#252629" Padding="18">
        <StackPanel>
            <TextBlock Text="Choose a colour" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TextBlock Text="Palette" FontSize="11" Foreground="#AEB4BF" Margin="0,0,0,6"/>
            <UniformGrid Columns="6" Margin="0,0,0,14">
                <Button Tag="#FFFFFFFF" Background="#FFFFFFFF" ToolTip="White" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF000000" Background="#FF000000" ToolTip="Black" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FFE9EDF5" Background="#FFE9EDF5" ToolTip="Light gray" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF808080" Background="#FF808080" ToolTip="Gray" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF343740" Background="#FF343740" ToolTip="Charcoal" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FFFF0000" Background="#FFFF0000" ToolTip="Red" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FFFF7A00" Background="#FFFF7A00" ToolTip="Orange" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FFFFD000" Background="#FFFFD000" ToolTip="Yellow" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF00B35A" Background="#FF00B35A" ToolTip="Green" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF00A3E0" Background="#FF00A3E0" ToolTip="Cyan" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FF1769FF" Background="#FF1769FF" ToolTip="Blue" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
                <Button Tag="#FFD83B7D" Background="#FFD83B7D" ToolTip="Pink" Click="Swatch_Click" Width="34" Height="34" Margin="3" Padding="0"/>
            </UniformGrid>
            <TextBlock Text="Custom HEX" FontSize="11" Foreground="#AEB4BF" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,4">
                <Border x:Name="ColorPreviewBorder" Width="34" Height="30" BorderBrush="#626671" BorderThickness="1"
                        CornerRadius="3" Background="#FFFFFFFF" DockPanel.Dock="Left"/>
                <TextBox x:Name="HexColorTextBox" Text="#FFFFFFFF" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ValidationTextBlock" Foreground="#FF8585" FontSize="10" MinHeight="18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="78" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="Apply" IsDefault="True" MinWidth="78"
                        Background="#087FC4" Foreground="White" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
