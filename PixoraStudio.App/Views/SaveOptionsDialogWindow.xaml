<Window x:Class="PixoraStudio.App.Views.SaveOptionsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#414141"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ScalePresetOption" TargetType="RadioButton">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#079BD8"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#079BD8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#64C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,12,0">
                <TextBlock Text="Save" FontWeight="SemiBold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="×" Width="32" Height="30" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" FontSize="22"
                        Foreground="#B8B8B8" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,12,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.82*"/>
                    <ColumnDefinition Width="1.18*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,26,0" VerticalAlignment="Top">
                    <Border x:Name="PreviewBackground" Height="405" Background="#080808"
                            BorderBrush="#3A3A3A" BorderThickness="1"
                            Padding="8" CornerRadius="2">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="PreviewFormatText" Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock x:Name="PreviewDimensionsText" Foreground="#AAAAAA"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Name" FontWeight="SemiBold"/>
                        <DockPanel LastChildFill="True" Margin="0,2,0,0">
                            <TextBlock x:Name="FileExtensionText" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="10,5,0,0"
                                       Foreground="#C8C8C8"/>
                            <TextBox x:Name="FileNameTextBox" Margin="0,5,0,0"
                                     ToolTip="Choose a name for the exported file"/>
                        </DockPanel>

                        <TextBlock Text="Save to" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <DockPanel LastChildFill="True">
                            <Button Content="Browse" DockPanel.Dock="Right" Margin="8,5,0,0"
                                    Click="BrowseFolder_Click"/>
                            <TextBox x:Name="FolderPathTextBox" IsReadOnly="True"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>

                        <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <UniformGrid Columns="2" Rows="3">
                            <Border x:Name="JpgCard" Tag="Jpg" Height="62" Margin="3"
                                    Padding="9,6" CornerRadius="6" BorderThickness="1"
                                    Background="#343434" BorderBrush="#454545"
                                    Cursor="Hand" MouseLeftButtonDown="FormatCard_Click">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="JPG" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Smaller files for photos and sharing"
                                               Foreground="#B9B9B9" FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="PngCard" Tag="Png" Height="62" Margin="3"
                                    Padding="9,6" CornerRadius="6" BorderThickness="1"
                                    Background="#343434" BorderBrush="#454545"
                                    Cursor="Hand" MouseLeftButtonDown="FormatCard_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PNG" FontWeight="SemiBold"/>
                                    <TextBlock Text="Lossless with transparency" Foreground="#B9B9B9"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="WebpCard" Tag="WebP" Height="62" Margin="3"
                                    Padding="9,6" CornerRadius="6" BorderThickness="1"
                                    Background="#343434" BorderBrush="#454545"
                                    Cursor="Hand" MouseLeftButtonDown="FormatCard_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="WebP" FontWeight="SemiBold"/>
                                    <TextBlock Text="Modern web image format" Foreground="#B9B9B9"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="BmpCard" Tag="Bmp" Height="62" Margin="3"
                                    Padding="9,6" CornerRadius="6" BorderThickness="1"
                                    Background="#343434" BorderBrush="#454545"
                                    Cursor="Hand" MouseLeftButtonDown="FormatCard_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BMP" FontWeight="SemiBold"/>
                                    <TextBlock Text="Uncompressed bitmap" Foreground="#B9B9B9"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="IconCard" Tag="Icon" Height="62" Margin="3"
                                    Padding="9,6" CornerRadius="6" BorderThickness="1"
                                    Background="#343434" BorderBrush="#454545"
                                    Cursor="Hand" MouseLeftButtonDown="FormatCard_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ICO" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows icon with multiple sizes" Foreground="#B9B9B9"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="TransparencyHint"
                                   Text="This image has transparency. Choose PNG or WebP to keep it."
                                   Foreground="#8BC5FF" FontSize="11" TextWrapping="Wrap"
                                   Margin="5,2,5,4" Visibility="Collapsed"/>

                        <Border Background="#2D2D2D" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="3,8,3,4">
                            <StackPanel>
                                <StackPanel x:Name="QualityPanel">
                                    <DockPanel>
                                        <TextBlock Text="Quality" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="QualityValueText" DockPanel.Dock="Right"
                                                   Text="90%" Foreground="#E8E8E8"/>
                                    </DockPanel>
                                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="90"
                                            Margin="0,8,0,8" ValueChanged="QualitySlider_ValueChanged"/>
                                    <UniformGrid Columns="3">
                                        <Button Content="LOW" Tag="35" Margin="2" Click="QualityPreset_Click"/>
                                        <Button Content="MED" Tag="65" Margin="2" Click="QualityPreset_Click"/>
                                        <Button Content="HIGH" Tag="90" Margin="2" Click="QualityPreset_Click"/>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel x:Name="DimensionsPanel" Margin="0,10,0,0">
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="Output size" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="LockAspectRatioCheckBox" Content="Lock proportions"
                                                  IsChecked="True" Foreground="#D4D4D4"
                                                  HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,0,0,6">
                                        <RadioButton x:Name="OneXScaleRadioButton"
                                                     Style="{StaticResource ScalePresetOption}"
                                                     GroupName="OutputScalePreset" Content="1×" Tag="1"
                                                     IsChecked="True" Click="ScalePreset_Click"/>
                                        <RadioButton x:Name="TwoXScaleRadioButton"
                                                     Style="{StaticResource ScalePresetOption}"
                                                     GroupName="OutputScalePreset" Content="2×" Tag="2"
                                                     Click="ScalePreset_Click"/>
                                        <RadioButton x:Name="FourXScaleRadioButton"
                                                     Style="{StaticResource ScalePresetOption}"
                                                     GroupName="OutputScalePreset" Content="4×" Tag="4"
                                                     Click="ScalePreset_Click"/>
                                        <RadioButton x:Name="CustomScaleRadioButton"
                                                     Style="{StaticResource ScalePresetOption}"
                                                     GroupName="OutputScalePreset" Content="Custom" Tag="Custom"
                                                     Click="ScalePreset_Click"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Width (px)" Foreground="#C9C9C9"/>
                                            <TextBox x:Name="WidthTextBox" Text="1"
                                                     LostFocus="WidthTextBox_LostFocus"
                                                     TextChanged="DimensionsTextBox_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Height (px)" Foreground="#C9C9C9"/>
                                            <TextBox x:Name="HeightTextBox" Text="1"
                                                     LostFocus="HeightTextBox_LostFocus"
                                                     TextChanged="DimensionsTextBox_TextChanged"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="PixoraAiUpscaleCheckBox"
                                              Content="Use Pixora AI (4×)"
                                              IsEnabled="False"
                                              Foreground="#D4D4D4"
                                              Margin="2,10,2,2"
                                              Click="PixoraAiUpscale_Click"/>
                                    <ComboBox x:Name="PixoraAiModelComboBox"
                                              IsEnabled="False"
                                              Height="32"
                                              Margin="2,4,2,4"
                                              Padding="8,4"
                                              Foreground="#D4D4D4"
                                              Background="#343434"
                                              BorderBrush="#4A4A4A"/>
                                    <TextBlock x:Name="PixoraAiUpscaleHint"
                                               Text="Train a local Pixora model first."
                                               Foreground="#9C9C9C"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="3,0,3,0"/>
                                </StackPanel>

                                <StackPanel x:Name="IconSizesPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="Icon sizes" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="4">
                                        <CheckBox x:Name="Icon16CheckBox" Content="16 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon24CheckBox" Content="24 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon32CheckBox" Content="32 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon48CheckBox" Content="48 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon64CheckBox" Content="64 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon128CheckBox" Content="128 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                        <CheckBox x:Name="Icon256CheckBox" Content="256 px" IsChecked="True"
                                                  Foreground="#D4D4D4" Margin="2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ValidationText" Foreground="#FF8A80" TextWrapping="Wrap"
                                   Margin="4,4,4,8" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#222222" CornerRadius="0,0,8,8" Padding="18,10">
                <DockPanel LastChildFill="False">
                    <Button Content="Cancel" Width="104" Margin="0,0,10,0"
                            DockPanel.Dock="Right" Background="Transparent"
                            BorderBrush="#777777" Click="Cancel_Click"/>
                    <Button Content="Save" Width="112" Margin="0,0,0,0"
                            DockPanel.Dock="Right" Background="#079BD8"
                            BorderBrush="#079BD8" Foreground="White" FontWeight="SemiBold"
                            Click="Save_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
