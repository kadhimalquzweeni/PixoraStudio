<UserControl x:Class="PixoraStudio.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#17191E">
        <StackPanel Margin="50,45">

            <TextBlock Text="{Binding WelcomeMessage}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="What would you like to create today?"
                       FontSize="15"
                       Foreground="#A0A3AD"
                       Margin="0,10,0,35"/>

            <UniformGrid Columns="2">

                <Border Background="#22252D"
                        CornerRadius="16"
                        Margin="0,0,12,0"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="PHOTO STUDIO"
                                   Foreground="#8BC5FF"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Photo Editor"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,8"/>

                        <TextBlock Text="Enhance photos, apply filters, crop and adjust images."
                                   Foreground="#A0A3AD"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>

                        <Button Content="Open Photo Editor"
                                Command="{Binding DataContext.OpenPhotoEditorCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#3478D4"
                                Foreground="White"
                                Padding="12,8"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Background="#22252D"
                        CornerRadius="16"
                        Margin="12,0,0,0"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="VIDEO STUDIO"
                                   Foreground="#C5A1FF"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Video Editor"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,8"/>

                        <TextBlock Text="Trim clips, split videos, rearrange footage and create videos."
                                   Foreground="#A0A3AD"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>

                        <Button Content="Open Video Editor"
                                Command="{Binding DataContext.OpenVideoEditorCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#7651C8"
                                Foreground="White"
                                Padding="12,8"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Background="#22252D"
                        CornerRadius="16"
                        Margin="0,24,12,0"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="DOCUMENT TOOLS"
                                   Foreground="#9FC8B8"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock Text="PDF Converter"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,8"/>

                        <TextBlock Text="Convert PDF pages into high-quality PNG or JPG images."
                                   Foreground="#A0A3AD"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>

                        <Button Content="Open PDF Converter"
                                Command="{Binding DataContext.OpenPdfConverterCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#328A78"
                                Foreground="White"
                                Padding="12,8"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Background="#22252D"
                        CornerRadius="16"
                        Margin="12,24,0,0"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="ONLINE MEDIA"
                                   Foreground="#8BC5FF"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Media Downloader"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,8"/>
                        <TextBlock Text="Prepare video links from popular platforms for downloading."
                                   Foreground="#A0A3AD"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>
                        <Button Content="Open Media Downloader"
                                Command="{Binding DataContext.OpenMediaDownloaderCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#3478D4"
                                Foreground="White"
                                Padding="12,8"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>