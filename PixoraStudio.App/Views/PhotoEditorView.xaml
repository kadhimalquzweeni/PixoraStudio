<UserControl x:Class="PixoraStudio.App.Views.PhotoEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PixoraStudio.App.Controls"
    Focusable="True"
    IsTabStop="True"
    DataContextChanged="PhotoEditorView_DataContextChanged"
    Loaded="PhotoEditorView_Loaded"
    PreviewMouseDown="PhotoEditorView_PreviewMouseDown"
    PreviewKeyDown="PhotoEditorView_PreviewKeyDown">
    <UserControl.Resources>
        <DrawingBrush x:Key="TransparencyCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,24,24"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F0F0F0" Geometry="M0,0 H24 V24 H0 Z"/>
                    <GeometryDrawing Brush="#D8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,12,12"/>
                                <RectangleGeometry Rect="12,12,12,12"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="CutoutBrushCheckerboard"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,16,16"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#202226" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#303238">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="CutoutSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track" Background="#3A3D42" CornerRadius="10"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#C8CBD2"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00A0CA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CutoutMagicSettings" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CutoutTool}" Value="Magic">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CutoutBrushSettings" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CutoutTool}" Value="Brush">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CutoutNonBrushSettings" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CutoutTool}" Value="Select">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CutoutTool}" Value="Magic">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D5D7DC"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="19"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NoSelectedLayerHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLayer}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoCanvasHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImageLoaded}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedLayerRequiredPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLayer}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CutoutOption" TargetType="RadioButton">
            <Setter Property="Background" Value="#343740"/>
            <Setter Property="Foreground" Value="#D4D6DE"/>
            <Setter Property="BorderBrush" Value="#454954"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#00A0CA"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#00A0CA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6B7180"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D6DE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#343740"/><Setter Property="Foreground" Value="#F0F1F4"/>
            <Setter Property="BorderBrush" Value="#454954"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#17191E">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>

        <Border Background="#22252D" Padding="12,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="PIXORA" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="New Canvas" Command="{Binding NewCanvasCommand}"
                            Background="#087FC4" Foreground="White" Padding="12,6"
                            ToolTip="Create a blank canvas"/>
                    <Button Content="Canvas Size" Command="{Binding ResizeCanvasCommand}"
                            IsEnabled="{Binding IsImageLoaded}" ToolTip="Change the document canvas dimensions"/>
                    <Button Content="Open image" Command="{Binding OpenImageCommand}"
                            ToolTip="Open an image as a new document"/>
                    <CheckBox Content="Snap" IsChecked="{Binding IsSnappingEnabled}" Foreground="White" VerticalAlignment="Center" Margin="8,2" ToolTip="Snap layers to the canvas and other layers"/>
                    <ToggleButton Content="Preview original" IsChecked="{Binding ShowOriginal}" Foreground="White" Background="#343740" Padding="9,5" Margin="8,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition x:Name="ToolSettingsColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="176"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#25272C">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Margin="2,8">
                        <Button Style="{StaticResource ToolButton}" ToolTip="Back to Home" Click="CloseEditor_Click">
                            <controls:SvgIcon IconName="house" Width="23" Height="23" Stroke="#C5C5C5"/>
                        </Button>
                        <Separator Width="34" Margin="4,8"/>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Arrange" Tag="0" Click="Tool_Click"><controls:SvgIcon IconName="mouse-pointer-2" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Crop" Tag="2" Click="Tool_Click"><controls:SvgIcon IconName="crop" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Cutout" Tag="3" Click="Tool_Click"><controls:SvgIcon IconName="scissors" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Adjustments" Tag="5" Click="Tool_Click"><controls:SvgIcon IconName="sliders-horizontal" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Filters" Tag="6" Click="Tool_Click"><controls:SvgIcon IconName="contrast" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Effects" Tag="7" Click="Tool_Click"><controls:SvgIcon IconName="wand-sparkles" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Retouch" Tag="8" Click="Tool_Click"><controls:SvgIcon IconName="eraser" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Text" Tag="9" Click="Tool_Click"><controls:SvgIcon IconName="type" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Shapes" Tag="10" Click="Tool_Click"><controls:SvgIcon IconName="shapes" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="Draw" Tag="11" Click="Tool_Click"><controls:SvgIcon IconName="paintbrush" Width="23" Height="23" Stroke="#C5C5C5"/></Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#171819" ClipToBounds="True">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="300" MinHeight="300">
                            <Grid x:Name="DocumentCanvas" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                  Margin="4096" ClipToBounds="False"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Background="{StaticResource TransparencyCheckerboard}">
                                <Grid.RenderTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Grid.RenderTransform>
                                <Border x:Name="GpuPreviewHost">
                                    <controls:SafeGpuPreviewElement x:Name="GpuPreview"
                                                                    Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                                    Focusable="False" IsHitTestVisible="False"
                                                                    PaintSurface="GpuPreview_PaintSurface"
                                                                    RenderFailed="GpuPreview_RenderFailed"/>
                                </Border>
                                <Image x:Name="CpuPreviewImage" Source="{Binding PreviewImage}"
                                       Stretch="Fill" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"/>
                                <Canvas Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                        IsHitTestVisible="False">
                                    <Image Source="{Binding LayerDragPreviewImage}"
                                           Opacity="{Binding SelectedLayer.Opacity}"
                                           Width="{Binding LayerDragPreviewWidth}"
                                           Height="{Binding LayerDragPreviewHeight}"
                                           Canvas.Left="{Binding LayerDragPreviewX}"
                                           Canvas.Top="{Binding LayerDragPreviewY}"
                                           Stretch="Fill"/>
                                </Canvas>
                                <Canvas x:Name="SnapGuideOverlay" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                    IsHitTestVisible="False"/>
                                <Canvas x:Name="CropOverlay" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                    Background="Transparent" Visibility="Collapsed"
                                    MouseLeftButtonDown="CropOverlay_MouseLeftButtonDown" MouseMove="CropOverlay_MouseMove"
                                    MouseLeftButtonUp="CropOverlay_MouseLeftButtonUp"/>
                                <Canvas x:Name="LayerOverlay"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent" ClipToBounds="False"
                                    MouseLeftButtonDown="LayerOverlay_MouseLeftButtonDown" MouseMove="LayerOverlay_MouseMove"
                                    MouseLeftButtonUp="LayerOverlay_MouseLeftButtonUp"/>
                                <Canvas x:Name="CutoutOverlay" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                    Background="Transparent" Visibility="Collapsed"
                                    MouseLeftButtonDown="CutoutOverlay_MouseLeftButtonDown"
                                    MouseMove="CutoutOverlay_MouseMove"
                                    MouseLeftButtonUp="CutoutOverlay_MouseLeftButtonUp"/>
                                <Border BorderBrush="#8BC5FF" BorderThickness="1"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Border Background="#17191E" Panel.ZIndex="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImageLoaded}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="Start with a canvas" FontSize="26" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Create a blank document, or open an image to begin editing."
                                       Foreground="#A0A3AD" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,10,0,22"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="＋  New Canvas" Command="{Binding NewCanvasCommand}"
                                        Background="#087FC4" Foreground="White" Padding="18,10"/>
                                <Button Content="Open image" Command="{Binding OpenImageCommand}"
                                        Padding="18,10" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" x:Name="ToolSettingsBorder" Background="#24262B" BorderBrush="#35383F" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Grid x:Name="ToolSettingsPanel" Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Button Content="×" Width="28" Height="26" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Foreground="#AEB2BE"
                                ToolTip="Close tools panel" Click="CloseToolSettings_Click"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TabControl x:Name="ToolSettingsTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0">

                            <TabItem Header="Arrange">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Arrange" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a layer to edit its properties."
                                                   Style="{StaticResource NoSelectedLayerHint}"
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                        <StackPanel Style="{StaticResource SelectedLayerRequiredPanel}">
                                            <TextBlock Text="Name" FontWeight="SemiBold" Margin="2,0,2,4"/>
                                            <TextBox Text="{Binding SelectedLayer.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                     LostKeyboardFocus="LayerProperty_LostKeyboardFocus"
                                                     Margin="2,0,2,12"/>

                                            <DockPanel Margin="2,0,2,4">
                                                <TextBlock Text="Opacity" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding SelectedLayer.OpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}"
                                                             IsEnabled="{Binding SelectedLayer.IsEditable}"
                                                             GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                             LostKeyboardFocus="LayerProperty_LostKeyboardFocus"
                                                             HorizontalContentAlignment="Right" Width="52" Margin="0,0,4,0"
                                                             ToolTip="Enter opacity from 0 to 100 percent"/>
                                                    <TextBlock Text="%" Foreground="#AEB2BE" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Slider x:Name="SelectLayerOpacitySlider" Minimum="0" Maximum="100"
                                                    Value="{Binding SelectedLayer.OpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding SelectedLayer.IsEditable}"
                                                    PreviewMouseLeftButtonDown="SelectLayerOpacitySlider_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="SelectLayerOpacitySlider_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="SelectLayerOpacitySlider_PreviewMouseLeftButtonUp"
                                                    LostMouseCapture="SelectLayerOpacitySlider_LostMouseCapture"
                                                    PreviewKeyDown="SelectLayerOpacitySlider_PreviewKeyDown"
                                                    PreviewKeyUp="SelectLayerOpacitySlider_PreviewKeyUp"
                                                    GotKeyboardFocus="SelectLayerOpacitySlider_GotKeyboardFocus"
                                                    LostKeyboardFocus="SelectLayerOpacitySlider_LostKeyboardFocus"
                                                    Margin="2,0,2,12"/>

                                            <Expander Header="Transform" IsExpanded="True" Margin="0,2,0,10">
                                                <StackPanel Margin="2,8,2,2" IsEnabled="{Binding SelectedLayer.IsEditable}">
                                                    <UniformGrid Columns="2">
                                                        <StackPanel Margin="2">
                                                            <TextBlock Text="X"/>
                                                            <TextBox Text="{Binding SelectedLayer.X, UpdateSourceTrigger=PropertyChanged}"
                                                                     GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                                     LostKeyboardFocus="LayerProperty_LostKeyboardFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="2">
                                                            <TextBlock Text="Width"/>
                                                            <TextBox Tag="Width" Text="{Binding SelectedLayer.Width, UpdateSourceTrigger=PropertyChanged}"
                                                                     GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                                     LostKeyboardFocus="LayerProperty_LostKeyboardFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="2">
                                                            <TextBlock Text="Y"/>
                                                            <TextBox Text="{Binding SelectedLayer.Y, UpdateSourceTrigger=PropertyChanged}"
                                                                     GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                                     LostKeyboardFocus="LayerProperty_LostKeyboardFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="2">
                                                            <TextBlock Text="Height"/>
                                                            <TextBox Tag="Height" Text="{Binding SelectedLayer.Height, UpdateSourceTrigger=PropertyChanged}"
                                                                     GotKeyboardFocus="LayerProperty_GotKeyboardFocus"
                                                                     LostKeyboardFocus="LayerProperty_LostKeyboardFocus"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <CheckBox Content="Lock aspect ratio" IsChecked="{Binding LockAspectRatio}"
                                                              Foreground="#D4D6DE" Margin="4,8,0,12"/>
                                                    <DockPanel Margin="2,0,2,4">
                                                        <TextBlock Text="Rotate" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                            <TextBox Text="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                                                                     HorizontalContentAlignment="Right" Width="58"
                                                                     ToolTip="Rotation angle in degrees"/>
                                                            <TextBlock Text="°" Foreground="#AEB2BE" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Slider Minimum="-180" Maximum="180" Value="{Binding RotationAngle}"
                                                            Margin="2,0,2,8"/>
                                                    <UniformGrid Columns="2">
                                                        <Button Content="Reset rotation" Command="{Binding ResetRotationCommand}"/>
                                                        <Button Content="Apply rotation" Command="{Binding ApplyRotationCommand}"
                                                                Background="#087FC4"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Expander>

                                            <UniformGrid Columns="2">
                                                <Button Content="Flip horizontal" Command="{Binding FlipHorizontalCommand}"/>
                                                <Button Content="Flip vertical" Command="{Binding FlipVerticalCommand}"/>
                                                <Button Content="Duplicate" Command="{Binding DuplicateLayerCommand}"
                                                        CommandParameter="{Binding SelectedLayer}"/>
                                                <Button Content="Delete" Command="{Binding RemoveLayerCommand}"
                                                        CommandParameter="{Binding SelectedLayer}"/>
                                            </UniformGrid>

                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Transform">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Transform" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a layer to access its transform controls."
                                                   Style="{StaticResource NoSelectedLayerHint}"
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                        <StackPanel Style="{StaticResource SelectedLayerRequiredPanel}">
                                            <UniformGrid Columns="2">
                                                <Button Content="↶ Rotate left" Command="{Binding RotateCounterClockwiseCommand}"/>
                                                <Button Content="↷ Rotate right" Command="{Binding RotateClockwiseCommand}"/>
                                                <Button Content="Rotate 180°" Command="{Binding Rotate180Command}"/>
                                                <Button Content="Flip horizontal" Command="{Binding FlipHorizontalCommand}"/>
                                                <Button Content="Flip vertical" Command="{Binding FlipVerticalCommand}"/>
                                            </UniformGrid>
                                            <Separator Margin="0,12"/>
                                            <TextBlock Text="Straighten" FontWeight="SemiBold"/>
                                            <DockPanel Margin="0,8">
                                                <TextBlock Text="Angle"/>
                                                <TextBlock Text="{Binding RotationAngle, StringFormat={}{0:F1}°}"
                                                           Foreground="#8BC5FF" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Slider Minimum="-45" Maximum="45" Value="{Binding RotationAngle}" Margin="0,4,0,10"/>
                                            <UniformGrid Columns="2">
                                                <Button Content="Reset" Command="{Binding ResetRotationCommand}"/>
                                                <Button Content="Apply" Command="{Binding ApplyRotationCommand}" Background="#087FC4"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Crop">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Crop" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a layer to access its crop controls."
                                                   Style="{StaticResource NoSelectedLayerHint}"
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                        <StackPanel Style="{StaticResource SelectedLayerRequiredPanel}">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="Width"/>
                                                    <TextBox Text="{Binding CropWidth, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                </StackPanel>
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="Height"/>
                                                    <TextBox Text="{Binding CropHeight, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <Expander Header="Select aspect" Margin="2,8,2,10">
                                                <ComboBox x:Name="CropAspectRatioCombo" SelectedIndex="0"
                                                          SelectionChanged="CropAspectRatio_SelectionChanged" Margin="2,8">
                                                    <ComboBoxItem Content="Free" Tag="free"/>
                                                    <ComboBoxItem Content="Original" Tag="original"/>
                                                    <ComboBoxItem Content="Square (1:1)" Tag="1"/>
                                                    <ComboBoxItem Content="4:3" Tag="1.3333333"/>
                                                    <ComboBoxItem Content="3:2" Tag="1.5"/>
                                                    <ComboBoxItem Content="16:9" Tag="1.7777778"/>
                                                    <ComboBoxItem Content="9:16" Tag="0.5625"/>
                                                </ComboBox>
                                            </Expander>

                                            <TextBlock Text="The selected layer is ready to crop. Drag its bounds to adjust; click outside the crop area or switch tools to stop."
                                                       Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,8"/>
                                            <Button Content="Apply crop" Click="ApplyCrop_Click"
                                                    Background="#087FC4" Margin="2,4,2,12"
                                                    IsEnabled="{Binding SelectedLayer.IsEditable}"/>

                                            <Border Background="#22252D" BorderBrush="#35383F" BorderThickness="1"
                                                    CornerRadius="8" Padding="10" Margin="0,4,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Rotate &amp; flip" FontWeight="SemiBold" Margin="2,0,2,8"/>
                                                    <UniformGrid Columns="4">
                                                        <Button Content="↶" Command="{Binding RotateCounterClockwiseCommand}"
                                                                ToolTip="Rotate left" IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                        <Button Content="↷" Command="{Binding RotateClockwiseCommand}"
                                                                ToolTip="Rotate right" IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                        <Button Content="↕" Command="{Binding FlipVerticalCommand}"
                                                                ToolTip="Flip vertical" IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                        <Button Content="↔" Command="{Binding FlipHorizontalCommand}"
                                                                ToolTip="Flip horizontal" IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#22252D" BorderBrush="#35383F" BorderThickness="1"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Resize" FontWeight="SemiBold" Margin="2,0,2,8"/>
                                                    <Button Content="▣  Image size" Click="OpenImageSize_Click"
                                                            IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                    <Button Content="▧  Canvas size" Click="ResizeCanvasFromCrop_Click"
                                                            IsEnabled="{Binding IsImageLoaded}"/>
                                                    <Button Content="◩  Smart resize" Click="SmartResize_Click"
                                                            ToolTip="Open image size controls with aspect ratio locked"
                                                            IsEnabled="{Binding SelectedLayer.IsEditable}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Cutout">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Cutout" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a layer to access its cutout tools."
                                                   Style="{StaticResource NoSelectedLayerHint}"
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                        <StackPanel Style="{StaticResource SelectedLayerRequiredPanel}" IsEnabled="{Binding SelectedLayer.IsEditable}">
                                            <Border Background="#25272C" BorderBrush="#35383F" BorderThickness="1"
                                                    CornerRadius="8" Padding="10" Margin="0,2,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Tool" FontWeight="SemiBold" Margin="2,0,2,6"/>
                                                    <UniformGrid Columns="4">
                                                        <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutTools"
                                                                     Tag="Tool|Select" Content="▣" ToolTip="Shape selection"
                                                                     Checked="CutoutOption_Checked" IsChecked="True"/>
                                                        <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutTools"
                                                                     Tag="Tool|Magic" Content="✣" ToolTip="Magic cutout"
                                                                     Checked="CutoutOption_Checked"/>
                                                        <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutTools"
                                                                     Tag="Tool|Brush" Content="✎" ToolTip="Draw cutout"
                                                                     Checked="CutoutOption_Checked"/>
                                                    </UniformGrid>
                                                    <TextBlock Text="Mode" FontWeight="SemiBold" Margin="2,8,2,4"/>
                                                    <UniformGrid Columns="2">
                                                        <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutMode"
                                                                     Tag="Mode|Keep" Content="KEEP"
                                                                     Checked="CutoutOption_Checked" IsChecked="True"/>
                                                        <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutMode"
                                                                     Tag="Mode|Remove" Content="REMOVE"
                                                                     Checked="CutoutOption_Checked"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#25272C" BorderBrush="#35383F" BorderThickness="1"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Style="{StaticResource CutoutMagicSettings}">
                                                        <DockPanel Margin="2,0,2,5">
                                                            <TextBlock Text="Tolerance" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CutoutTolerance}" DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="1"
                                                                IsMoveToPointEnabled="True"
                                                                Value="{Binding CutoutTolerance, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>

                                                    <StackPanel Style="{StaticResource CutoutNonBrushSettings}">
                                                        <TextBlock Text="Softness" FontWeight="SemiBold" Margin="2,8,2,4"/>
                                                        <UniformGrid Columns="3">
                                                            <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutSoftness"
                                                                         Tag="Softness|None" Content="NONE"
                                                                         Checked="CutoutOption_Checked" IsChecked="True"/>
                                                            <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutSoftness"
                                                                         Tag="Softness|Light" Content="LIGHT"
                                                                         Checked="CutoutOption_Checked"/>
                                                            <RadioButton Style="{StaticResource CutoutOption}" GroupName="CutoutSoftness"
                                                                         Tag="Softness|Medium" Content="MEDIUM"
                                                                         Checked="CutoutOption_Checked"/>
                                                        </UniformGrid>
                                                    </StackPanel>

                                                    <StackPanel Style="{StaticResource CutoutBrushSettings}">
                                                        <TextBlock Text="Brush" FontWeight="SemiBold" Margin="2,0,2,6"/>
                                                        <Border Height="88" Margin="2,0,2,8" CornerRadius="4"
                                                                Background="{StaticResource CutoutBrushCheckerboard}"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Ellipse Width="{Binding CutoutBrushSize}" Height="{Binding CutoutBrushSize}"
                                                                         MaxWidth="72" MaxHeight="72"
                                                                         Fill="#31E83F" HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" Opacity="0.9">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect Color="#24FF3B" BlurRadius="16"
                                                                                          ShadowDepth="0" Opacity="0.95"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                            </Grid>
                                                        </Border>
                                                        <DockPanel Margin="2,3,2,0">
                                                            <TextBlock Text="Size" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CutoutBrushSize, StringFormat={}{0:F0}px}"
                                                                       DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                        <Slider Minimum="1" Maximum="100" TickFrequency="1"
                                                                IsMoveToPointEnabled="True"
                                                                Value="{Binding CutoutBrushSize, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <DockPanel Margin="2,8,2,0">
                                                            <TextBlock Text="Softness" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CutoutBrushSoftness, StringFormat={}{0:F0}%}"
                                                                       DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="1"
                                                                IsMoveToPointEnabled="True"
                                                                Value="{Binding CutoutBrushSoftness, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>

                                                    <StackPanel Style="{StaticResource CutoutMagicSettings}">
                                                        <DockPanel Margin="2,10,2,0">
                                                            <TextBlock Text="Contiguous" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <CheckBox Style="{StaticResource CutoutSwitch}"
                                                                      IsChecked="{Binding CutoutContiguous}"
                                                                      DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#25272C" BorderBrush="#35383F" BorderThickness="1"
                                                    CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <DockPanel Margin="2,0,2,8">
                                                        <TextBlock Text="Hint removed" FontWeight="SemiBold"/>
                                                        <CheckBox Style="{StaticResource CutoutSwitch}"
                                                                  IsChecked="{Binding CutoutHintRemoved}"
                                                                  Checked="CutoutHintRemoved_Changed"
                                                                  Unchecked="CutoutHintRemoved_Changed"
                                                                  DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <Button Content="Invert cutout" Click="InvertCutout_Click"
                                                            IsEnabled="{Binding HasCutoutSelection}"
                                                            Background="Transparent" BorderBrush="#AEB2BE"
                                                            BorderThickness="1" Padding="10,7" Margin="0,4"/>
                                                    <Button Content="Reset cutout" Click="ResetCutout_Click"
                                                            IsEnabled="{Binding HasCutoutSelection}"
                                                            Background="Transparent" BorderBrush="#AEB2BE"
                                                            BorderThickness="1" Padding="10,7" Margin="0,4"/>
                                                    <Button Content="Apply cutout" Click="ApplyCutout_Click"
                                                            IsEnabled="{Binding HasCutoutSelection}"
                                                            Background="Transparent" BorderBrush="#AEB2BE"
                                                            BorderThickness="1" Padding="10,7" Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Close" Click="CloseCutout_Click"
                                                Background="Transparent" BorderBrush="#AEB2BE"
                                                BorderThickness="1" Padding="10,7" Margin="2,6,2,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Resize">
                                <StackPanel>
                                    <TextBlock Text="Resize" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Select a layer to access its resize controls."
                                               Style="{StaticResource NoSelectedLayerHint}"
                                               Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                    <StackPanel Style="{StaticResource SelectedLayerRequiredPanel}">
                                        <CheckBox Content="Lock aspect ratio" IsChecked="{Binding LockAspectRatio}"
                                                  Foreground="#D4D6DE" Margin="2,0,0,8"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2">
                                                <TextBlock Text="Width"/>
                                                <TextBox Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="Height"/>
                                                <TextBox Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Content="Apply resize" Command="{Binding ResizeCommand}"
                                                Background="#087FC4" Margin="2,10"/>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Adjustments">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Adjustments" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <TextBlock Text="Select an image to access its adjustments."
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsImageLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsImageLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
