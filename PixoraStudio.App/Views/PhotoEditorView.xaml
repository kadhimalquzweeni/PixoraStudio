<UserControl x:Class="PixoraStudio.App.Views.PhotoEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#17191E">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Background="#22252D" Padding="10">
            <DockPanel LastChildFill="True">
                <Button Content="Export Image" Command="{Binding SaveImageCommand}"
                        Background="#3478D4" Foreground="White" Padding="15,5"
                        BorderThickness="0" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,5,0"/>
                    <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="0,0,15,0"/>
                    <Button Content="Reset Adjustments" Command="{Binding ResetAdjustmentsCommand}" Margin="0,0,12,0"/>
                    <ToggleButton Content="Original" IsChecked="{Binding ShowOriginal}" Foreground="White"
                                  Background="#343740" Padding="10,5" Margin="0,0,12,0"/>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Margin="0,0,5,0"/>
                    <Button Content="Fit" Command="{Binding FitToScreenCommand}" Margin="0,0,5,0"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Background="#202127" CornerRadius="10" Margin="0,0,15,0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="300" MinHeight="300">
                        <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            </Grid.RenderTransform>
                            <Image Source="{Binding PreviewImage}" Stretch="Fill"
                                   Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"/>
                            <Canvas x:Name="CropOverlay" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                    Background="Transparent" Visibility="Collapsed"
                                    MouseLeftButtonDown="CropOverlay_MouseLeftButtonDown"
                                    MouseMove="CropOverlay_MouseMove"
                                    MouseLeftButtonUp="CropOverlay_MouseLeftButtonUp"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#22252D" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Transform" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Rows="3">
                            <Button Content="↶ Rotate left" Command="{Binding RotateCounterClockwiseCommand}" Margin="2"/>
                            <Button Content="↷ Rotate right" Command="{Binding RotateClockwiseCommand}" Margin="2"/>
                            <Button Content="Rotate 180°" Command="{Binding Rotate180Command}" Margin="2"/>
                            <Button Content="Flip horizontal" Command="{Binding FlipHorizontalCommand}" Margin="2"/>
                            <Button Content="Flip vertical" Command="{Binding FlipVerticalCommand}" Margin="2"/>
                        </UniformGrid>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="Crop" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Button Content="Start visual crop" Click="StartCrop_Click" Background="#3478D4" Foreground="White" Margin="2,0,2,8"/>
                        <StackPanel x:Name="CropActionPanel" Visibility="Collapsed">
                            <TextBlock Text="Drag inside the box to move it. Drag an edge or corner to resize." Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,0,2,6"/>
                            <TextBlock Text="Aspect ratio" Foreground="#D4D6DE" Margin="2,4,2,3"/>
                            <ComboBox x:Name="CropAspectRatioCombo" SelectedIndex="0"
                                      SelectionChanged="CropAspectRatio_SelectionChanged" Margin="2,0,2,7">
                                <ComboBoxItem Content="Free" Tag="free"/>
                                <ComboBoxItem Content="Original" Tag="original"/>
                                <ComboBoxItem Content="Square (1:1)" Tag="1"/>
                                <ComboBoxItem Content="4:3" Tag="1.3333333"/>
                                <ComboBoxItem Content="3:2" Tag="1.5"/>
                                <ComboBoxItem Content="16:9" Tag="1.7777778"/>
                                <ComboBoxItem Content="9:16" Tag="0.5625"/>
                            </ComboBox>
                            <UniformGrid Columns="2">
                                <Button Content="Apply crop" Click="ApplyVisualCrop_Click" Background="#3478D4" Foreground="White" Margin="2"/>
                                <Button Content="Cancel" Click="CancelVisualCrop_Click" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                        <TextBlock Text="Or enter position and size (pixels)" Foreground="#AEB2BE" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="2"><TextBlock Text="X" Foreground="#D4D6DE"/><TextBox Text="{Binding CropX, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Y" Foreground="#D4D6DE"/><TextBox Text="{Binding CropY, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Width" Foreground="#D4D6DE"/><TextBox Text="{Binding CropWidth, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Height" Foreground="#D4D6DE"/><TextBox Text="{Binding CropHeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                        <Button Content="Apply crop" Command="{Binding CropCommand}" Background="#3478D4" Foreground="White" Margin="2,8,2,2"/>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="Resize" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox Content="Lock aspect ratio" IsChecked="{Binding LockAspectRatio}" Foreground="#D4D6DE" Margin="2,0,0,8"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="2"><TextBlock Text="Width" Foreground="#D4D6DE"/><TextBox Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Height" Foreground="#D4D6DE"/><TextBox Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                        <Button Content="Apply resize" Command="{Binding ResizeCommand}" Margin="2,8,2,2"/>

                        <TextBlock Text="Straighten / Free rotation" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <DockPanel>
                            <TextBlock Text="Angle" Foreground="#D4D6DE"/>
                            <TextBlock Text="{Binding RotationAngle, StringFormat={}{0:F1}°}" Foreground="#8BC5FF" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider Minimum="-45" Maximum="45" Value="{Binding RotationAngle}" TickFrequency="0.5"
                                IsSnapToTickEnabled="False" Margin="0,8,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="Reset angle" Command="{Binding ResetRotationCommand}" Margin="2"/>
                            <Button Content="Apply rotation" Command="{Binding ApplyRotationCommand}" Background="#3478D4" Foreground="White" Margin="2"/>
                        </UniformGrid>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="Adjustments" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DockPanel><TextBlock Text="Brightness" Foreground="#D4D6DE"/><TextBlock Text="{Binding Brightness, StringFormat={}{0:F0}}" Foreground="#8BC5FF" DockPanel.Dock="Right"/></DockPanel>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" Margin="0,8,0,14"/>
                        <DockPanel><TextBlock Text="Contrast" Foreground="#D4D6DE"/><TextBlock Text="{Binding Contrast, StringFormat={}{0:F2}}" Foreground="#8BC5FF" DockPanel.Dock="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="3" Value="{Binding Contrast}" Margin="0,8,0,14"/>
                        <DockPanel><TextBlock Text="Saturation" Foreground="#D4D6DE"/><TextBlock Text="{Binding Saturation, StringFormat={}{0:F2}}" Foreground="#8BC5FF" DockPanel.Dock="Right"/></DockPanel>
                        <Slider Minimum="0" Maximum="3" Value="{Binding Saturation}" Margin="0,8,0,14"/>
                        <Button Content="Save adjustment to history" Command="{Binding CommitAdjustmentsCommand}" Margin="0,0,0,10"/>

                        <TextBlock Text="Filters" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Button Content="Original" Command="{Binding ResetAdjustmentsCommand}" Margin="0,0,0,5"/>
                        <Button Content="Grayscale" Click="Grayscale_Click" Margin="0,0,0,5"/>
                        <Button Content="Sepia" Click="Sepia_Click" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding OperationError}" Foreground="#FF8585" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#22252D">
            <DockPanel Margin="15,0">
                <TextBlock Text="{Binding ImagePath}" Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ImageWidth, StringFormat={}{0} px}" Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                <TextBlock Text=" × " Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding ImageHeight, StringFormat={}{0} px}" Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
