                                            </StackPanel.Style>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Brightness, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Contrast" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Contrast, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="×" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="3" Value="{Binding Contrast}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Saturation" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Saturation, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="×" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="3" Value="{Binding Saturation}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Exposure" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Exposure, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="EV" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-3" Maximum="3" Value="{Binding Exposure}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Highlights" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Highlights, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Highlights}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shadows" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Shadows, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Shadows}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Temperature" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Temperature, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Temperature}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
                                                LostMouseCapture="AdjustmentSlider_LostMouseCapture"
                                                Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tint" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Tint, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="#30343B" Foreground="#F0F1F4" CaretBrush="White"
                                                     BorderBrush="#454954" Padding="5,3" Margin="4,0,0,0"
                                                     GotKeyboardFocus="AdjustmentValueBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="AdjustmentValueBox_LostKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="AdjustmentValueBox_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AdjustmentValueBox_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#AEB2BE" FontSize="11"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Tint}"
                                                IsMoveToPointEnabled="True"
                                                PreviewMouseLeftButtonDown="AdjustmentSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="AdjustmentSlider_PreviewMouseLeftButtonUp"
                                                PreviewKeyDown="AdjustmentSlider_PreviewKeyDown"
                                                PreviewKeyUp="AdjustmentSlider_PreviewKeyUp"
                                                GotKeyboardFocus="AdjustmentSlider_GotKeyboardFocus"
                                                LostKeyboardFocus="AdjustmentSlider_LostKeyboardFocus"
