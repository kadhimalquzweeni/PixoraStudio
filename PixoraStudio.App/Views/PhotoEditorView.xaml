                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Filters">
                                <StackPanel>
                                    <TextBlock Text="Filters" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Select an image to access its filters."
                                               Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLayer.IsImageLayer}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLayer.IsImageLayer}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="Original" Command="{Binding ResetAdjustmentsCommand}"/>
                                        <Button Content="Grayscale" Click="Grayscale_Click"/>
                                        <Button Content="Sepia" Click="Sepia_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Effects"><StackPanel><TextBlock Text="Effects" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Creative effects will appear here." Foreground="#AEB2BE" TextWrapping="Wrap" Margin="0,8"/></StackPanel></TabItem>
                            <TabItem Header="Retouch"><StackPanel><TextBlock Text="Retouch" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Retouching tools are planned for a future update." Foreground="#AEB2BE" TextWrapping="Wrap" Margin="0,8"/></StackPanel></TabItem>
                            <TabItem Header="Text">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Text" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a text layer to edit its typography." Foreground="#AEB2BE"
                                                   TextWrapping="Wrap" Margin="2,4,2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsTextLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel IsEnabled="{Binding SelectedLayer.IsEditable}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsTextLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Text content" FontSize="10" Foreground="#AEB2BE"/>
                                            <TextBox Text="{Binding SelectedLayer.TextContent, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,2,0,10"/>
                                            <TextBlock Text="Text alignment" FontSize="10" Foreground="#AEB2BE"/>
                                            <ComboBox SelectedValue="{Binding SelectedLayer.TextAlignment}" SelectedValuePath="Content" Margin="0,2,0,10">
                                                <ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/>
                                            </ComboBox>
                                            <TextBlock Text="Font family" FontSize="10" Foreground="#AEB2BE"/>
                                            <ComboBox ItemsSource="{Binding FontFamilies}" IsEditable="True" IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True"
                                                      Text="{Binding SelectedLayer.FontFamily, UpdateSourceTrigger=LostFocus}"
                                                      Margin="0,2,0,10"/>
                                            <DockPanel>
                                                <TextBlock Text="Font size" Foreground="#AEB2BE" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedLayer.FontSize, StringFormat={}{0:0}}"
                                                           Foreground="#AEB2BE" FontSize="10" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="256" Value="{Binding SelectedLayer.FontSize}" Margin="0,2,0,8"/>
                                            <TextBlock Text="Text fill colour" FontSize="10" Foreground="#AEB2BE"/>
                                            <Button Click="PickFillColor_Click" HorizontalContentAlignment="Stretch" Margin="2,2,2,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" Background="{Binding SelectedLayer.FillColor}"
                                                            BorderBrush="#737783" BorderThickness="1" CornerRadius="3"/>
                                                    <TextBlock Text="{Binding SelectedLayer.FillColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose" Foreground="#8BC5FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Text stroke colour" FontSize="10" Foreground="#AEB2BE"/>
                                            <Button Click="PickStrokeColor_Click" HorizontalContentAlignment="Stretch" Margin="2,2,2,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" Background="{Binding SelectedLayer.StrokeColor}"
                                                            BorderBrush="#737783" BorderThickness="1" CornerRadius="3"/>
                                                    <TextBlock Text="{Binding SelectedLayer.StrokeColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose" Foreground="#8BC5FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <DockPanel>
                                                <TextBlock Text="Stroke width" Foreground="#AEB2BE" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedLayer.StrokeWidth, StringFormat={}{0:0}}"
                                                           Foreground="#AEB2BE" FontSize="10" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="64" Value="{Binding SelectedLayer.StrokeWidth}" Margin="0,2,0,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Shapes">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Shapes" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a shape layer to edit its appearance." Foreground="#AEB2BE"
                                                   TextWrapping="Wrap" Margin="2,4,2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsShapeLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel IsEnabled="{Binding SelectedLayer.IsEditable}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLayer.IsShapeLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Shape" FontSize="10" Foreground="#AEB2BE"/>
                                            <ComboBox SelectedValue="{Binding SelectedLayer.ShapeType}" SelectedValuePath="Content" Margin="0,2,0,10">
                                                <ComboBoxItem Content="Rectangle"/><ComboBoxItem Content="Ellipse"/><ComboBoxItem Content="Line"/><ComboBoxItem Content="Arrow"/>
                                            </ComboBox>
                                            <TextBlock Text="Fill colour" FontSize="10" Foreground="#AEB2BE"/>
                                            <Button Click="PickFillColor_Click" HorizontalContentAlignment="Stretch" Margin="2,2,2,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" Background="{Binding SelectedLayer.FillColor}"
                                                            BorderBrush="#737783" BorderThickness="1" CornerRadius="3"/>
                                                    <TextBlock Text="{Binding SelectedLayer.FillColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose" Foreground="#8BC5FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Stroke colour" FontSize="10" Foreground="#AEB2BE"/>
                                            <Button Click="PickStrokeColor_Click" HorizontalContentAlignment="Stretch" Margin="2,2,2,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" Background="{Binding SelectedLayer.StrokeColor}"
                                                            BorderBrush="#737783" BorderThickness="1" CornerRadius="3"/>
                                                    <TextBlock Text="{Binding SelectedLayer.StrokeColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose" Foreground="#8BC5FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <DockPanel>
                                                <TextBlock Text="Stroke width" Foreground="#AEB2BE" FontSize="10"/>
                                                <TextBlock Text="{Binding SelectedLayer.StrokeWidth, StringFormat={}{0:0}}"
                                                           Foreground="#AEB2BE" FontSize="10" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="64" Value="{Binding SelectedLayer.StrokeWidth}" Margin="0,2,0,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                                                    <TabItem Header="Draw">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Draw" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Paint on the canvas with a round brush. Each stroke is added as its own editable layer."
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,0,2,14"/>
                                        <TextBlock Text="Create or open a canvas to start drawing."
                                                   Style="{StaticResource NoCanvasHint}"
                                                   Foreground="#AEB2BE" TextWrapping="Wrap" Margin="2,4,2,12"/>
                                        <StackPanel IsEnabled="{Binding IsImageLoaded}">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="Brush size" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding BrushSize, StringFormat={}{0:0} px}"
                                                           Foreground="#8BC5FF" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <TextBox Text="{Binding BrushSize, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}"
                                                         Width="58" HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center" DockPanel.Dock="Right"/>
                                                <Slider Minimum="1" Maximum="100" Value="{Binding BrushSize}"
                                                        IsMoveToPointEnabled="True" Margin="0,0,8,0"/>
                                            </DockPanel>
                                            <TextBlock Text="Brush colour" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Button Click="PickBrushColor_Click" HorizontalContentAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" Background="{Binding BrushColor}"
                                                            BorderBrush="#737783" BorderThickness="1" CornerRadius="3"/>
                                                    <TextBlock Text="{Binding BrushColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose" Foreground="#8BC5FF"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
</TabControl>
                        <TextBlock Text="{Binding OperationError}" Foreground="#FF8585" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="3" Background="#252629" BorderBrush="#35383F" BorderThickness="1,0,0,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="Layers" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="＋" DockPanel.Dock="Right" Command="{Binding AddLayerCommand}" IsEnabled="{Binding IsImageLoaded}"
                                Background="#087FC4" Foreground="White" FontSize="20" Width="34" Height="30"
                                Padding="0" Margin="12,0,0,0" ToolTip="Add a layer"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AdditionalLayers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="72" Height="72" Background="#30343B" BorderThickness="1" CornerRadius="5" Margin="2"
                                            MouseLeftButtonDown="LayerItem_MouseLeftButtonDown"
                                            PreviewMouseMove="LayerItem_PreviewMouseMove"
                                            DragOver="LayerItem_DragOver" Drop="LayerItem_Drop"
                                            AllowDrop="True" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#454954"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#168DD0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Border Background="{StaticResource TransparencyCheckerboard}" CornerRadius="4">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" Opacity="{Binding Opacity}"/>
                                            </Border>
                                            <Border Background="#D917191E" VerticalAlignment="Bottom" Padding="3,2" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Name}" Foreground="#F0F1F4" FontSize="10"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxHeight="24"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="3" IsHitTestVisible="False">
                                                <Border Background="#D911141A" CornerRadius="3" Padding="3,1" Margin="0,0,3,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="LOCK" Foreground="#FFD9E0EA" FontSize="7" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#D911141A" CornerRadius="3" Padding="3,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="HIDDEN" Foreground="#FFFFD28A" FontSize="7" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <Button x:Name="LayerOptionsButton" Content="…" Width="22" Height="20" Padding="0"
                                                    Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#CC17191E" Foreground="White" BorderBrush="#555963"
                                                    ToolTip="Layer settings" Click="LayerProperties_Click"/>
                                            <Popup IsOpen="{Binding IsPropertiesOpen, Mode=TwoWay}"
                                                   Placement="Left"
                                                   PlacementTarget="{Binding ElementName=LayerOptionsButton}"
                                                   StaysOpen="True"
                                                   AllowsTransparency="True"
                                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                   Opened="LayerPropertiesPopup_Opened">
                                                <Border Width="260" Background="#252629" BorderBrush="#454954"
                                                        BorderThickness="1" CornerRadius="8" Padding="12"
                                                        Tag="LayerPropertiesPopupContent">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Layer settings" FontSize="14" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Content="×" Width="26" Height="26" Padding="0"
                                                                    DockPanel.Dock="Right" Background="Transparent"
                                                                    BorderThickness="0" Foreground="#AEB2BE"
                                                                    Click="CloseLayerProperties_Click"/>
                                                        </DockPanel>
                                                        <StackPanel Grid.Row="1">
                                                            <TextBlock Text="Name" FontSize="11" Foreground="#AEB4BF"/>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                     Margin="0,3,0,12"/>
                                                            <DockPanel>
                                                                <TextBlock Text="Opacity" FontSize="11" Foreground="#AEB4BF"/>
                                                                <TextBox Text="{Binding OpacityPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                                                         Width="42" HorizontalContentAlignment="Right"
                                                                         DockPanel.Dock="Right" Margin="0,0,4,0"/>
                                                                <TextBlock Text="%" FontSize="11" Foreground="#D4D6DE"
                                                                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="100"
                                                                    Value="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                                                    Focusable="True" IsHitTestVisible="True"
                                                                    PreviewMouseLeftButtonDown="LayerOpacitySlider_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="LayerOpacitySlider_PreviewMouseMove"
                                                                    PreviewMouseLeftButtonUp="LayerOpacitySlider_PreviewMouseLeftButtonUp"
                                                                    Margin="0,2,0,12"/>
                                                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                                                <ToggleButton Content="Locked" IsChecked="{Binding IsLocked}"
                                                                              Margin="0,0,4,0" Padding="8,8"/>
                                                                <ToggleButton Content="Visible" IsChecked="{Binding IsVisible}"
                                                                              Margin="4,0,0,0" Padding="8,8"/>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                        <UniformGrid Grid.Row="2" Columns="2">
                                                            <Button Content="Duplicate" Click="DuplicateLayerFromPopup_Click"
                                                                    Margin="0,0,4,0"/>
                                                            <Button Content="Remove" Click="RemoveLayerFromPopup_Click"
                                                                    Margin="4,0,0,0"/>
                                                        </UniformGrid>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#202124" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Width="30" Padding="0"/>
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Foreground="#8BC5FF" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Content="＋" Command="{Binding ZoomInCommand}" Width="30" Padding="0"/>
                    <Button Content="Fit" Command="{Binding FitToScreenCommand}" Margin="8,2"/>
                    <TextBlock Text="{Binding ImageWidth, StringFormat={}{0} px}" Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text=" × " Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImageHeight, StringFormat={}{0} px}" Foreground="#8A8D97" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="UNDO  ↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Background="Transparent" BorderThickness="0" Foreground="#B8BBC5" Padding="12,6"/>
                    <Button Content="REDO  ↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Background="Transparent" BorderThickness="0" Foreground="#B8BBC5" Padding="12,6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close" Click="CloseEditor_Click" Background="Transparent" BorderBrush="#555963" Padding="20,5" Margin="4"/>
                    <Button Content="Save" Command="{Binding SaveImageCommand}" Background="#079BD8" Foreground="White" BorderThickness="0" Padding="22,5" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>