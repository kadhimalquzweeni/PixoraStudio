<UserControl x:Class="PixoraStudio.App.Views.VideoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

    <UserControl.Resources>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3478D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B8FE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#438BE8"/>
                    <Setter Property="BorderBrush" Value="#69A5F2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2864B5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#343A46"/>
                    <Setter Property="Foreground" Value="#858B96"/>
                    <Setter Property="BorderBrush" Value="#454B56"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#383D48"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#4A505D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454C59"/>
                    <Setter Property="BorderBrush" Value="#626B7B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#303540"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#191B20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Background="#20232A"
                BorderBrush="#303641"
                BorderThickness="0,0,0,1"
                Padding="18,11">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="PIXORA"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text=" STUDIO"
                           Foreground="#999999"
                           FontSize="20"
                           FontWeight="Light"/>

            </StackPanel>
        </Border>

        <!-- Video Preview Area -->
        <Border x:Name="VideoPreviewBorder"
                Grid.Row="1"
                Background="#101216"
                BorderBrush="#343A45"
                BorderThickness="1"
                Margin="18,16"
                CornerRadius="10"
                ClipToBounds="True">

            <Grid Background="#111111">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- VLC Video Host -->
                <Grid x:Name="VideoHost"
                      Grid.Row="0"
                      Background="#111111">

                    <vlc:VideoView x:Name="VideoPlayer"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
                    <Image x:Name="ManagedVideoFrame"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                    <!-- Temporary filmstrip frame shown while the fullscreen slider is dragged. -->
                    <Image x:Name="ScrubPreviewFrame"
                           Panel.ZIndex="10"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                </Grid>

                <!-- Playback Controls Below Video -->
                <Border x:Name="PlaybackControlsBorder"
                        Grid.Row="1"
                        Background="#E6191D24"
                        BorderBrush="#303641"
                        BorderThickness="0,1,0,0"
                        Padding="18,11">

                    <Grid>

                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentTime}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="/"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                        <Button Grid.Column="4"
                                Click="MuteButton_Click"
                                Margin="10,0,6,0"
                                Width="36"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="Change volume or mute"
                                Style="{StaticResource IconButtonStyle}">
                            <Path Style="{StaticResource VolumeLevelIconStyle}"
                                  Width="19"
                                  Height="19"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Button>

                        <Slider x:Name="VolumeSlider"
                                Grid.Column="5"
                                Minimum="0"
                                Maximum="100"
                                IsMoveToPointEnabled="True"
                                Value="{Binding Volume, Mode=TwoWay}"
                                Width="110"
                                VerticalAlignment="Center"
                                PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                ValueChanged="VolumeSlider_ValueChanged"/>



                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Bottom Editing Panel -->
        <Border x:Name="BottomEditingPanel"
                Grid.Row="2"
                Background="#20232A"
                BorderBrush="#303641"
                BorderThickness="0,1,0,0"
                Padding="18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- Video Information -->
                    <TextBlock Text="VIDEO DETAILS"
                               Foreground="#8F9AAA"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Border Background="#292E38"
                            BorderBrush="#3A414D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding VideoName}"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9,0,0">

                        <TextBlock Text="DURATION"
                                   Foreground="#8F9AAA"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="RESOLUTION"
                                   Foreground="#8F9AAA"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding VideoResolution}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="FRAME RATE"
                                   Foreground="#8F9AAA"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding VideoFrameRate}"
                                   Foreground="White"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Timeline -->
                    <Border Background="#252A33"
                            BorderBrush="#3A414D"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="TIMELINE"
                                       Foreground="#DCE2EA"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <Canvas x:Name="TrimTimelineCanvas"
                                    Height="76"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="TrimTimeline_MouseDown"
                                    MouseMove="TrimTimeline_MouseMove"
                                    MouseLeftButtonUp="TrimTimeline_MouseUp"
                                    SizeChanged="TrimTimeline_SizeChanged">

                                <!-- Actual Video Frames -->
                                <ItemsControl x:Name="Filmstrip"
                                              ItemsSource="{Binding VideoFrames}"
                                              Height="38"
                                              Canvas.Left="0"
                                              Canvas.Top="28"
                                              IsHitTestVisible="False">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding}"
                                                   Height="38"
                                                   Stretch="UniformToFill"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- Selected Trim Range -->
                                <Border x:Name="SelectionRange"
                                        Height="38"
                                        Background="#552196F3"
                                        BorderBrush="#2196F3"
                                        BorderThickness="1"
                                        Canvas.Top="28"/>

                                <!-- Playback Playhead -->
                                <Border x:Name="Playhead"
                                        Width="3"
                                        Height="52"
                                        Background="White"
                                        Canvas.Top="18"/>

                                <!-- Start Trim Handle -->
                                <Border x:Name="LeftTrimHandle"
                                        Width="12"
                                        Height="28"
                                        Background="#4FC3F7"
                                        CornerRadius="3"
                                        Cursor="SizeWE"
                                        Canvas.Top="33"/>

                                <!-- End Trim Handle -->
                                <Border x:Name="RightTrimHandle"
                                        Width="12"
                                        Height="28"
                                        Background="#4FC3F7"
                                        CornerRadius="3"
                                        Cursor="SizeWE"
                                        Canvas.Top="33"/>

                                <!-- Playback Time Label -->
                                <TextBlock x:Name="PlayheadTimeLabel"
                                           Text="00:00"
                                           Foreground="White"
                                           Background="#2196F3"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="48"
                                           IsHitTestVisible="False"/>

                                <!-- Trim Start Time Label -->
                                <TextBlock x:Name="TrimStartTimeLabel"
                                           Text="00:00"
                                           Foreground="#4FC3F7"
                                           Background="#303030"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="0"
                                           IsHitTestVisible="False"/>

                                <!-- Trim End Time Label -->
                                <TextBlock x:Name="TrimEndTimeLabel"
                                           Text="00:00"
                                           Foreground="#4FC3F7"
                                           Background="#303030"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="0"
                                           IsHitTestVisible="False"/>

                            </Canvas>

                            <!-- Timeline Information -->
                            <Grid Margin="0,8,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TrimStartTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Left"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding TrimDurationTime,
                                           StringFormat='Selected: {0}'}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TrimEndTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Right"/>

                            </Grid>

                            <!-- Timeline Instructions -->
                            <TextBlock Text="Drag the blue handles to select the video section. Click or drag elsewhere to move the playhead."
                                       Foreground="#888888"
                                       FontSize="11"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                    <!-- Video Trimming -->
                    <Border Background="#252A33"
                            BorderBrush="#3A414D"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="16"
                            Margin="0,0,0,0">

                        <StackPanel>

                            <TextBlock Text="EXPORT"
                                       Foreground="#8F9AAA"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Trim Selection"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding TrimDurationTime,
                                              StringFormat='Selected clip duration: {0}'}"
                                       Foreground="White"
                                       FontSize="14"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Managed MP4 export preserves the original encoded quality and trims on video frame boundaries. Keyframe preroll is retained for decoding but hidden from playback."
                                       Foreground="#AAAAAA"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">

                                <Button Content="Reset Trim"
                                        Command="{Binding ResetTrimCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Margin="0,0,10,0"/>

                                <Button Content="Export Trimmed Video"
                                        Command="{Binding ExportTrimmedVideoCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Margin="0,0,10,0"/>

                                <Button Content="Cancel Export"
                                        Command="{Binding CancelExportCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"/>

                            </StackPanel>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ExportProgress}"
                                         Height="8"
                                         Margin="0,14,0,0"
                                         Background="#171A20"
                                         Foreground="#3478D4">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <TextBlock Text="{Binding ExportStatusMessage}"
                                       Foreground="#AAAAAA"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#888888"
                               Margin="0,10,0,0"/>

                    <!-- Errors -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>

</UserControl>