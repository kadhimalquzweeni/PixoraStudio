<UserControl x:Class="PixoraStudio.App.Views.VideoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Background="#252526"
                Padding="16,10">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="PIXORA"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text=" STUDIO"
                           Foreground="#999999"
                           FontSize="20"
                           FontWeight="Light"/>

            </StackPanel>
        </Border>

        <!-- Video Preview Area -->
        <Border x:Name="VideoPreviewBorder"
                Grid.Row="1"
                Background="#111111"
                Margin="20"
                CornerRadius="8"
                ClipToBounds="True">

            <Grid Background="#111111">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- VLC Video Host -->
                <Grid x:Name="VideoHost"
                      Grid.Row="0"
                      Background="#111111">

                    <vlc:VideoView x:Name="VideoPlayer"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
                    <Image x:Name="ManagedVideoFrame"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                </Grid>

                <!-- Playback Controls Below Video -->
                <Border x:Name="PlaybackControlsBorder"
                        Grid.Row="1"
                        Background="#DD17191E"
                        Padding="15,10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="◀ Frame"
                                    Command="{Binding PreviousFrameCommand}"
                                    IsEnabled="{Binding CanStepFrames}"
                                    ToolTip="Show previous video frame"
                                    Padding="8,4"
                                    Margin="0,0,6,0"/>
                            <Button Content="Frame ▶"
                                    Command="{Binding NextFrameCommand}"
                                    IsEnabled="{Binding CanStepFrames}"
                                    ToolTip="Show next video frame"
                                    Padding="8,4"
                                    Margin="0,0,10,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentTime}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="/"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                        <TextBlock Grid.Column="4"
                                   Text="Volume"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="10,0"/>

                        <Slider Grid.Column="5"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                Width="110"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <Button Grid.Column="6"
                                Content="{Binding MuteButtonText}"
                                Click="MuteButton_Click"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"/>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Bottom Editing Panel -->
        <Border x:Name="BottomEditingPanel"
                Grid.Row="2"
                Background="#252526"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- Video Information -->
                    <TextBlock Text="{Binding VideoName}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,10">

                        <TextBlock Text="Duration: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="Resolution: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoResolution}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="Frame Rate: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoFrameRate}"
                                   Foreground="White"/>

                    </StackPanel>

                    <!-- Timeline -->
                    <Border Background="#303030"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,5,0,5">

                        <StackPanel>

                            <TextBlock Text="TIMELINE"
                                       Foreground="#AAAAAA"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Canvas x:Name="TrimTimelineCanvas"
                                    Height="76"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="TrimTimeline_MouseDown"
                                    MouseMove="TrimTimeline_MouseMove"
                                    MouseLeftButtonUp="TrimTimeline_MouseUp"
                                    SizeChanged="TrimTimeline_SizeChanged">

                                <!-- Actual Video Frames -->
                                <ItemsControl x:Name="Filmstrip"
                                              ItemsSource="{Binding VideoFrames}"
                                              Height="38"
                                              Canvas.Left="0"
                                              Canvas.Top="28"
                                              IsHitTestVisible="False">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding}"
                                                   Height="38"
                                                   Stretch="UniformToFill"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- Selected Trim Range -->
                                <Border x:Name="SelectionRange"
                                        Height="38"
                                        Background="#552196F3"
                                        BorderBrush="#2196F3"
                                        BorderThickness="1"
                                        Canvas.Top="28"/>

                                <!-- Playback Playhead -->
                                <Border x:Name="Playhead"
                                        Width="3"
                                        Height="52"
                                        Background="White"
                                        Canvas.Top="18"/>

                                <!-- Start Trim Handle -->
                                <Border x:Name="LeftTrimHandle"
                                        Width="12"
                                        Height="28"
                                        Background="#4FC3F7"
                                        CornerRadius="3"
                                        Cursor="SizeWE"
                                        Canvas.Top="33"/>

                                <!-- End Trim Handle -->
                                <Border x:Name="RightTrimHandle"
                                        Width="12"
                                        Height="28"
                                        Background="#4FC3F7"
                                        CornerRadius="3"
                                        Cursor="SizeWE"
                                        Canvas.Top="33"/>

                                <!-- Playback Time Label -->
                                <TextBlock x:Name="PlayheadTimeLabel"
                                           Text="00:00"
                                           Foreground="White"
                                           Background="#2196F3"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="48"
                                           IsHitTestVisible="False"/>

                                <!-- Trim Start Time Label -->
                                <TextBlock x:Name="TrimStartTimeLabel"
                                           Text="00:00"
                                           Foreground="#4FC3F7"
                                           Background="#303030"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="0"
                                           IsHitTestVisible="False"/>

                                <!-- Trim End Time Label -->
                                <TextBlock x:Name="TrimEndTimeLabel"
                                           Text="00:00"
                                           Foreground="#4FC3F7"
                                           Background="#303030"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Padding="5,3"
                                           Canvas.Top="0"
                                           IsHitTestVisible="False"/>

                            </Canvas>

                            <!-- Timeline Information -->
                            <Grid Margin="0,8,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TrimStartTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Left"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding TrimDurationTime,
                                           StringFormat='Selected: {0}'}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TrimEndTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Right"/>

                            </Grid>

                            <!-- Timeline Instructions -->
                            <TextBlock Text="Drag the blue handles to select the video section. Click or drag elsewhere to move the playhead."
                                       Foreground="#888888"
                                       FontSize="11"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                    <!-- Video Trimming -->
                    <Border Background="#303030"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,5,0,0">

                        <StackPanel>

                            <TextBlock Text="Trim Selection"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="{Binding TrimDurationTime,
                                              StringFormat='Selected clip duration: {0}'}"
                                       Foreground="White"
                                       FontSize="14"
                                       Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">

                                <Button Content="Reset Trim"
                                        Command="{Binding ResetTrimCommand}"
                                        Padding="12,6"
                                        Margin="0,0,10,0"/>

                                <Button Content="Export Trimmed Video"
                                        Command="{Binding ExportTrimmedVideoCommand}"
                                        Padding="12,6"
                                        Margin="0,0,10,0"/>

                                <Button Content="Cancel Export"
                                        Command="{Binding CancelExportCommand}"
                                        Padding="12,6"/>

                            </StackPanel>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ExportProgress}"
                                         Height="7"
                                         Margin="0,12,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <TextBlock Text="{Binding ExportStatusMessage}"
                                       Foreground="#AAAAAA"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#888888"
                               Margin="0,10,0,0"/>

                    <!-- Errors -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>

</UserControl>