<UserControl x:Class="PixoraStudio.App.Views.VideoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PixoraStudio.App.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
<!-- Toolbar -->
<Border Grid.Row="0"
        Background="#252526"
        Padding="16,10">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- App Branding -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock Text="PIXORA"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text=" STUDIO"
                       Foreground="#999999"
                       FontSize="20"
                       FontWeight="Light"/>

        </StackPanel>

        <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                </StackPanel>
    </Grid>

</Border>


        <!-- Video Preview -->
        <Border Grid.Row="1"
                Background="#111111"
                Margin="20"
                CornerRadius="8">

            <vlc:VideoView x:Name="VideoPlayer"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

        </Border>

        <!-- Bottom Editing Panel -->
        <Border Grid.Row="2"
                Background="#252526"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- Video Information -->
                    <TextBlock Text="{Binding VideoName}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,10">

                        <TextBlock Text="Duration: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="Resolution: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoResolution}"
                                   Foreground="White"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="Frame Rate: "
                                   Foreground="#AAAAAA"/>

                        <TextBlock Text="{Binding VideoFrameRate}"
                                   Foreground="White"/>

                    </StackPanel>

                    <!-- Playback Timeline -->
                    <Slider x:Name="TimelineSlider"
                            Minimum="0"
                            Maximum="{Binding TotalMilliseconds}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}"
                            PreviewMouseDown="Timeline_MouseDown"
                            PreviewMouseUp="Timeline_MouseUp"/>

                    <!-- Playback Controls -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,5,0,10">

                        <Button Content="▶ / ⏸"
                                Command="{Binding PlayPauseCommand}"
                                Padding="15,8"
                                Margin="5"/>

                        <TextBlock Text="{Binding CurrentTime}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <TextBlock Text="/"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding VideoDuration}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <TextBlock Text="Volume"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <Slider Minimum="0"
                                Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                Width="120"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                    </StackPanel>

                    <!-- Video Trimming Panel -->
                    <Border Background="#303030"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,5,0,0">

                        <StackPanel>

                            <TextBlock Text="Video Trimming"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,15"/>

                            <!-- Trim Start -->
                            <DockPanel Margin="0,0,0,5">

                                <TextBlock Text="Start"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           DockPanel.Dock="Left"/>

                                <TextBlock Text="{Binding TrimStartTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Right"/>

                            </DockPanel>

                            <Slider Minimum="0"
                                    Maximum="{Binding TotalMilliseconds}"
                                    Value="{Binding TrimStart, Mode=TwoWay}"
                                    SmallChange="100"
                                    LargeChange="1000"
                                    Margin="0,0,0,15"/>

                            <!-- Trim End -->
                            <DockPanel Margin="0,0,0,5">

                                <TextBlock Text="End"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           DockPanel.Dock="Left"/>

                                <TextBlock Text="{Binding TrimEndTime}"
                                           Foreground="#4FC3F7"
                                           HorizontalAlignment="Right"/>

                            </DockPanel>

                            <Slider Minimum="0"
                                    Maximum="{Binding TotalMilliseconds}"
                                    Value="{Binding TrimEnd, Mode=TwoWay}"
                                    SmallChange="100"
                                    LargeChange="1000"
                                    Margin="0,0,0,15"/>

                            <!-- Selected Duration -->
                            <TextBlock Text="{Binding TrimDurationTime,
                                              StringFormat='Selected clip duration: {0}'}"
                                       Foreground="White"
                                       FontSize="14"
                                       Margin="0,0,0,15"/>

                            <!-- Trim Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">

                                <Button Content="Reset Trim"
                                        Command="{Binding ResetTrimCommand}"
                                        Padding="12,6"
                                        Margin="0,0,10,0"/>

                                <Button Content="Export Trimmed Video"
                                        Command="{Binding ExportTrimmedVideoCommand}"
                                        Padding="12,6"
                                        Background="#2196F3"
                                        Foreground="White"/>

                            </StackPanel>

                            <!-- Export Progress -->
                            <StackPanel Margin="0,15,0,0"
                                        Visibility="{Binding IsExporting,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                <TextBlock Text="{Binding ExportStatus}"
                                           Foreground="White"
                                           Margin="0,0,0,5"/>

                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ExportProgress}"
                                             Height="18"
                                             Margin="0,0,0,8"/>

                                <Button Content="Cancel Export"
                                        Command="{Binding CancelExportCommand}"
                                        HorizontalAlignment="Right"
                                        Padding="12,5"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- Status and Errors -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#888888"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>
